function Get-TinyTaskProcs {
    return @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.ProcessName -match 'tinytask' })
}

function Send-TinyTaskBack {
    $n = 0
    foreach ($p in (Get-TinyTaskProcs)) {
        if ($p.MainWindowHandle -ne [IntPtr]::Zero) {
            $script:TinyTaskHwnd = $p.MainWindowHandle
            [LocalKeyState]::HideWin($p.MainWindowHandle)
            $n++
        }
    }
    return $n
}

function Toggle-TinyTask {
    $h = $script:TinyTaskHwnd
    if ($h -eq [IntPtr]::Zero -or -not [LocalKeyState]::IsWindow($h)) {
        Show-Flag 'Tecla T' 'TinyTask no esta abierto'
        return
    }
    if ([LocalKeyState]::IsWindowVisible($h)) {
        [LocalKeyState]::HideWin($h)
        Close-Menu
    } else {
        Close-Menu
        [LocalKeyState]::ShowWin($h)
        [LocalKeyState]::ForceForeground($h)
    }
}

function Start-MacroFocusCheck {
    $script:TTPollTicks = 0
    $t1 = New-Object System.Windows.Threading.DispatcherTimer
    $t1.Interval = [TimeSpan]::FromMilliseconds(100)
    $t1.Add_Tick({
        param($s, $e)
        $script:TTPollTicks++
        if ((Send-TinyTaskBack) -gt 0 -or $script:TTPollTicks -ge 30) {
            $s.Stop()
            if ($script:CerrarTrasMacro) {
                $script:CerrarTrasMacro = $false
                Close-Menu
                $script:WatermarkAccent = $C.F1
                Show-Watermark 'AUDIT' 'MACRO AUDIT CARGADA'
            } elseif ($Win.Visibility -eq 'Visible') { Set-MenuFocus }
        }
    })
    $t1.Start()

    $t2 = New-Object System.Windows.Threading.DispatcherTimer
    $t2.Interval = [TimeSpan]::FromMilliseconds(1500)
    $t2.Add_Tick({
        param($s, $e)
        $s.Stop()
        Send-TinyTaskBack | Out-Null
        if ($Win.Visibility -eq 'Visible') { Set-MenuFocus }
        elseif ($script:UltimoRestaurado -ne [IntPtr]::Zero) {
            $fg = [LocalKeyState]::GetForeground()
            if ($fg -eq [IntPtr]::Zero -or $fg -eq $script:TinyTaskHwnd) {
                [LocalKeyState]::ForceForeground($script:UltimoRestaurado)
            }
        }
        if ((Get-TinyTaskProcs).Count -eq 0) {
            $script:CurrentMacroPath = $null
            Show-Flag 'TinyTask' 'Se mando abrir la macro pero TinyTask no aparecio'
        }
    })
    $t2.Start()
}

function Set-ActiveMacro([string]$path) {
    if (-not $script:MacrosDisponibles) { return }
    try {
        $running = Get-TinyTaskProcs
        if ($script:CurrentMacroPath -eq $path -and $running.Count -gt 0) { return }
        $running | Stop-Process -Force -ErrorAction SilentlyContinue
        $script:CurrentMacroPath = $null
        $script:TinyTaskHwnd = [IntPtr]::Zero
        if (-not (Test-Path -LiteralPath $path)) {
            Show-Flag 'Set-ActiveMacro' ('No existe la macro ' + (Split-Path $path -Leaf))
            return
        }
        try {
            Start-Process -FilePath $path
        } catch {
            if (-not $script:TinyTaskExe) { throw 'El .rec no abre TinyTask solo y no encontre tinytask.exe' }
            Start-Process -FilePath $script:TinyTaskExe -ArgumentList ('"' + $path + '"') -WorkingDirectory (Split-Path $path -Parent)
        }
        $script:CurrentMacroPath = $path
        $script:ReordenarAltTab = $true
        $script:MacroLanzada = $true
        Start-MacroFocusCheck
    } catch {
        $script:CurrentMacroPath = $null
        Show-Flag 'Set-ActiveMacro' $_.Exception.Message
    }
}

