function Draw-Done {
    $accent = Get-Accent
    $body = New-Object System.Windows.Controls.StackPanel
    [void]$body.Children.Add((New-Text 'Copiado' 18 $accent 'Bold'))

    if ($script:NotePair.Count -eq 2) {
