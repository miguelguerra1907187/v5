            $txt.IsReadOnly = $true
            $txt.IsUndoEnabled = $false
            $txt.BorderThickness = '0'
            $txt.Background = [System.Windows.Media.Brushes]::Transparent
            $txt.Foreground = B $C.Text
            $txt.CaretBrush = B $C.Text
