# --------------------------- coordenadas -------------------------------
function Leer-MisCoords {
    $r = @{}
    if (Test-Path $Global:ArchivoCoords) {
        foreach ($l in Get-Content $Global:ArchivoCoords) {
            if ($l -match '^\s*(\w+)\s*=\s*(-?\d+)\s*,\s*(-?\d+)') {
                $r[$Matches[1]] = @([int]$Matches[2], [int]$Matches[3])
            }
        }
    }
    return $r
}

function Guardar-MisCoords([hashtable]$mias) {
    $lineas = @(
        '# MIS COORDENADAS  (formato:  NOMBRE = X, Y)',
        '# Edita los numeros a mano si quieres. Borra una linea para volver',
        '# a usar la del companero en ese punto.',
        ''
    )
    foreach ($n in $Global:Puntos.Keys) {
        if ($mias.ContainsKey($n)) {
            $lineas += ('{0,-18} = {1}, {2}' -f $n, $mias[$n][0], $mias[$n][1]) + '      # ' + $Global:Puntos[$n].Desc
        }
    }
    Set-Content -Path $Global:ArchivoCoords -Value $lineas -Encoding UTF8
}

# Devuelve @(X,Y): el mio si existe (y esta activado), si no el del companero
function Get-XY([string]$nombre) {
    if ($Global:Coord -eq 1) {
        $m = Leer-MisCoords
        if ($m.ContainsKey($nombre)) { return $m[$nombre] }
    }
    return $Global:Puntos[$nombre].XY
}

function DobleClickXY([string]$nombre) {
    $p = Get-XY $nombre
    Paso "Doble click $nombre en $($p[0]),$($p[1])"
