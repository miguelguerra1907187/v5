# Se llama desde Finish-Notes: recuerda la ultima nota ERP y la de intra
function Set-NotasBotones([string]$intra, [string]$erp, [bool]$pendingHold, [string]$terminal = '') {
    # Que PRO lookup usar:
    #   - F2 (haz)               -> el original (las 2 intras)
    #   - F1 que lleva HOLD (cons) -> tambien el original, como F2
    #   - F1 sin hold            -> el de F1 (solo intra)
    if ($script:CurrentForce -eq 'haz') {
        $script:UltimoForce = 'haz'
    } elseif ($script:CurrentForce -eq 'f1') {
        $conHold = $pendingHold -or [bool]$terminal
        if (-not $conHold) { try { $conHold = [bool](Test-NeedsHold) } catch { } }
        $script:UltimoForce = if ($conHold) { 'haz' } else { 'f1' }
    } else {
        $script:UltimoForce = ''
    }

    # Nota nueva = se olvida la anterior (para no pegar la de otra bill)
    if ($erp -and ($script:CurrentForce -eq 'f1' -or $script:CurrentForce -eq 'haz')) {
        $script:BtnErp   = $erp.ToUpper()
        $script:BtnForce = if ($script:CurrentForce -eq 'f1') { 'FORCE1' } else { 'FORCE2' }
    } else {
        $script:BtnErp = ''; $script:BtnForce = ''
    }
    if ($terminal) {
        # Paso de terminal de la MISMA nota: si la nota ERP ya se pego, no se vuelve a ofrecer
        if ($script:BtnErp -and $script:BtnErp -eq $script:ErpYaPegada) { $script:BtnErp = ''; $script:BtnForce = '' }
    } else {
        $script:ErpYaPegada = ''      # nota nueva
    }
    if ($pendingHold) { $script:BtnIntra = '' }        # falta la terminal
    elseif ($intra)   { $script:BtnIntra = $intra.ToUpper() }
    Update-Barra
}

# 'f1' = PRO lookup F1 (solo intra)   'haz' = original (F2 o F1 con hold)
function Get-ForcePRO { return $script:UltimoForce }

function Update-Barra {
    if (-not $script:BotonesBarra.Count) { return }
    $b = $script:BotonesBarra
    $fz = Get-ForcePRO
    $txtPro = $b['pro'].Child
    if ($fz -eq 'f1') {
        $txtPro.Text = 'PRO F1'; $txtPro.Foreground = B $C.F1
        $b['pro'].BorderBrush = B $C.F1; $b['pro'].Background = B (Get-Soft $C.F1)
        $b['pro'].ToolTip = 'FORCE 1: busca el PRO solo en intra'
    } elseif ($fz -eq 'haz') {
        $txtPro.Text = 'PRO F2'; $txtPro.Foreground = B $C.HAZ   # F2 o F1 con hold
        $b['pro'].BorderBrush = B $C.HAZ; $b['pro'].Background = B (Get-Soft $C.HAZ)
        $b['pro'].ToolTip = 'F2 o F1 con hold: busca el PRO en intra normal y vieja'
    } else {
        $txtPro.Text = 'PRO'; $txtPro.Foreground = B $C.Dim
        $b['pro'].BorderBrush = B $C.Dim; $b['pro'].Background = B (Get-Soft $C.Dim)
        $b['pro'].ToolTip = 'Arma la nota primero (F1 o F2) para saber que PRO lookup usar'
    }
    $b['erp'].ToolTip   = if ($script:BtnErp)   { "$($script:BtnForce)  >  $($script:BtnErp)" } else { 'Todavia no hay nota ERP' }
    $b['intra'].ToolTip = if ($script:BtnIntra) { $script:BtnIntra } else { 'Todavia no hay nota de intra (o falta la terminal)' }
    $b['erp'].Opacity   = if ($script:BtnErp)   { 1.0 } else { 0.45 }
    $b['intra'].Opacity = if ($script:BtnIntra) { 1.0 } else { 0.45 }
    $b['pro'].Opacity   = if ($fz) { 1.0 } else { 0.45 }
    $pa = @(Get-PasosAuto)
    $b['auto'].Opacity  = if ($pa.Count) { 1.0 } else { 0.45 }
    $b['auto'].ToolTip  = if ($pa.Count) {
        'AUTO: ' + (($pa | ForEach-Object {
            switch ($_) { 'pro1' { 'PRO F1' } 'pro' { 'PRO (2 intras)' } 'intra' { 'nota intra' } 'erp' { 'nota ERP' } 'TERMINAL' { 'pedir terminal (al dar Enter pega intra y ERP)' } }
        }) -join '  >  ')
    } else { 'AUTO: arma la nota primero' }
}

function Set-BarraOcupada([bool]$ocupada) {
    if (-not $script:BotonesBarra.Count) { return }
    foreach ($k in @($script:BotonesBarra.Keys)) {
        if ($ocupada) { $script:BotonesBarra[$k].Opacity = 0.3 }
    }
    if (-not $ocupada) { Update-Barra }
    $Barra.Dispatcher.Invoke([action]{}, [System.Windows.Threading.DispatcherPriority]::Render)
}

# Ejecuta UNA accion del motor. Devuelve $true si salio bien.
# (no revisa si el motor esta ocupado; eso lo hacen Invoke-BotonMotor / Invoke-Auto)
function Run-Accion([string]$accion) {
    $ok = $false
    switch ($accion) {
        'pro1'  { $ok = Invoke-ProLookupF1 }
        'pro'   { $ok = Invoke-ProLookup }
        'erp'   { $ok = Invoke-NotaERP -Force $script:BtnForce -Nota $script:BtnErp }
        'intra' { $ok = Invoke-NotaIntra -Nota $script:BtnIntra }
    }
    if ($ok) {
        # Cada nota se pega UNA vez; para volver a pegarla, sacala del
        # historial (3/4/5 en la pantalla inicial) y se vuelve a cargar.
        if ($accion -eq 'erp')   { $script:ErpYaPegada = $script:BtnErp; $script:BtnErp = ''; $script:BtnForce = '' }
        if ($accion -eq 'intra') { $script:BtnIntra = '' }
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = '#3FB950'
        switch ($accion) {
            'pro1'  { Show-Watermark 'PRO'   'PRO BUSCADO EN INTRA (F1)' }
            'pro'   { Show-Watermark 'PRO'   'PRO BUSCADO EN LAS 2 INTRAS' }
            'erp'   { Show-Watermark 'ERP'   'NOTA ERP PEGADA - REVISA Y GUARDA' }
            'intra' { Show-Watermark 'INTRA' 'NOTA INTRA PEGADA - REVISA Y GUARDA' }
        }
        $script:WatermarkAccent = $acentoPrevio
    }
    return [bool]$ok
}

function Test-MotorListo {
    if ($script:MotorCorriendo) { return $false }
    if (-not $script:MotorOK) { Show-Flag 'Botones' $script:MotorError; return $false }
    if ($script:State -ne 'hidden' -and $script:State -ne 'done' -and $script:State -ne 'nivel1') {
        Show-Flag 'Botones' 'termina la nota primero (o Esc hasta la pantalla inicial)'
        return $false
    }
    return $true
}

# Cierra el menu antes de que el motor haga clicks, SIN perder la nota
# pendiente de hold (Close-Menu normalmente la borra)
function Close-MenuParaBoton {
    if ($script:State -eq 'hidden') { return }
    $ph = $script:PendingHold
    Close-Menu
    $script:PendingHold = $ph
    Start-Sleep -Milliseconds 150
}

function Invoke-BotonMotor([string]$accion) {
    if (-not (Test-MotorListo)) { return }
    if ($accion -eq 'pro') {
        $fz = Get-ForcePRO
        if (-not $fz) { Show-Flag 'PRO lookup' 'arma la nota primero (F1 o F2) para saber cual usar'; return }
        if ($fz -eq 'f1') { $accion = 'pro1' }
    }
    if ($accion -eq 'erp'   -and -not $script:BtnErp)   { Show-Flag 'Nota ERP'   'todavia no hay nota ERP'; return }
    if ($accion -eq 'intra' -and -not $script:BtnIntra) { Show-Flag 'Nota intra' 'todavia no hay nota de intra (falta la terminal?)'; return }

    $script:MotorCorriendo = $true
    Set-BarraOcupada $true
    try {
        Close-MenuParaBoton
        Hide-Watermark
        $okAcc = Run-Accion $accion
    } catch {
        Show-Flag "Boton $accion" $_.Exception.Message
        $okAcc = $false
    } finally {
        $script:MotorCorriendo = $false
        Set-BarraOcupada $false
    }
    # Despues del PRO, si la nota lleva hold y falta la terminal, la pide de una vez
    if ($okAcc -and ($accion -eq 'pro' -or $accion -eq 'pro1') -and $script:PendingHold -and -not $script:BtnIntra) {
        Abrir-TerminalAuto
    }
}

# ---------------------------------------------------------------------
#  BOTON AUTO: encadena todo segun el caso
#   F1 sin hold ............ PRO F1 -> nota intra -> nota ERP
#   Con hold (F1 cons / F2):
#     1er click ............ PRO original (2 intras) -> abre la terminal
#     tecleas terminal+Enter  -> pega solo nota intra -> nota ERP
#     (si ya diste la terminal antes, AUTO pega intra -> ERP)
#  Se detiene en el primer paso que falle. Tu siempre guardas.
# ---------------------------------------------------------------------
$script:AutoTrasTerminal = $false
$script:ErpYaPegada      = ''    # nota ERP que ya se pego (para no pegarla 2 veces)

function Get-PasosAuto {
    # Hold y todavia falta la terminal (aunque la nota ERP ya se haya pegado)
    if ($script:PendingHold -and -not $script:BtnIntra) { return @('pro', 'TERMINAL') }
    $r = @()
    if ($script:BtnIntra) {
        if ($script:UltimoForce -eq 'f1') { $r += 'pro1' }      # F1 sin hold: primero el PRO
        $r += 'intra'
    }
    if ($script:BtnErp) { $r += 'erp' }                      # solo si no se ha pegado
    return $r
}

# Abre la pantalla de terminal (como Insert). Al dar Enter ahi se pega
# sola la nota de intra (y la del ERP si todavia no se habia pegado).
function Abrir-TerminalAuto {
    $script:AutoTrasTerminal = $true
    Hide-Watermark
    if ($script:State -eq 'hidden') {
        Save-PrevForeground
        $Win.Visibility = 'Visible'
        Set-MenuFocus
    }
    Enter-Terminal
}

function Invoke-Auto {
    if (-not (Test-MotorListo)) { return }
    $pasos = @(Get-PasosAuto)
    if ($pasos.Count -eq 0) { Show-Flag 'AUTO' 'arma la nota primero (o ya se pegaron las notas)'; return }

    $script:MotorCorriendo = $true
    Set-BarraOcupada $true
    $abrirTerminal = $false
    try {
        Close-MenuParaBoton
        Hide-Watermark
        foreach ($p in $pasos) {
            if ($p -eq 'TERMINAL') { $abrirTerminal = $true; break }
            if (-not (Run-Accion $p)) { break }        # el motor ya mostro donde fallo
        }
    } catch {
        Show-Flag 'AUTO' $_.Exception.Message
    } finally {
        $script:MotorCorriendo = $false
        Set-BarraOcupada $false
    }

    if ($abrirTerminal) { Abrir-TerminalAuto }
}

# Se llama despues de dar la terminal (Enter) cuando venia de AUTO
function Start-AutoTrasTerminal {
    if (-not $script:AutoTrasTerminal) { return }
    $script:AutoTrasTerminal = $false
    # Pequena espera para que el menu termine de cerrarse
    $t = New-Object System.Windows.Threading.DispatcherTimer
    $t.Interval = [TimeSpan]::FromMilliseconds(400)
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if (-not (Test-MotorListo)) { return }
        $script:MotorCorriendo = $true
        Set-BarraOcupada $true
        try {
            if (Run-Accion 'intra') {
                if ($script:BtnErp) { Run-Accion 'erp' | Out-Null }   # solo si no se habia pegado
            }
        } catch {
            Show-Flag 'AUTO' $_.Exception.Message
        } finally {
            $script:MotorCorriendo = $false
            Set-BarraOcupada $false
        }
    })
    $t.Start()
}

$Barra = New-Object System.Windows.Window
$Barra.WindowStyle        = 'None'
$Barra.AllowsTransparency = $true
$Barra.Background         = 'Transparent'
$Barra.Topmost            = $true
$Barra.ShowInTaskbar      = $false
$Barra.ShowActivated      = $false
$Barra.ResizeMode         = 'NoResize'
$Barra.SizeToContent      = 'WidthAndHeight'
$Barra.Add_SourceInitialized({
    param($s, $e)
    $h = (New-Object System.Windows.Interop.WindowInteropHelper($Barra)).Handle
    [LocalKeyState]::HideFromAltTab($h)
    # Darle click a la barra NO le quita el foco a nada (asi el motor arranca limpio)
    try { [Motor]::NoActivate($h) } catch { }
})

$barraBorde = New-Object System.Windows.Controls.Border
$barraBorde.Background      = B '#E616191D'
$barraBorde.BorderBrush     = B $C.KeyBorder
$barraBorde.BorderThickness = '1'
$barraBorde.CornerRadius    = '10'
$barraBorde.Padding         = '6,6,6,6'
$barraBorde.Cursor          = 'SizeAll'
# Arrastrar la barra desde el borde (no desde los botones)
$barraBorde.Add_MouseLeftButtonDown({ param($s, $e) if ($e.OriginalSource -eq $s) { try { $Barra.DragMove() } catch { } } })

$barraFila = New-Object System.Windows.Controls.StackPanel
$barraFila.Orientation = 'Horizontal'
$barraBorde.Child = $barraFila

function New-BotonBarra([string]$texto, [string]$color, [string]$accion) {
    $b = New-Object System.Windows.Controls.Border
    $b.Background      = B (Get-Soft $color)
    $b.BorderBrush     = B $color
    $b.BorderThickness = '1.5'
    $b.CornerRadius    = '7'
    $b.Margin          = '3,0,3,0'
    $b.Padding         = '12,6,12,6'
    $b.Cursor          = 'Hand'
    $b.Tag             = $accion
    $t = New-Text $texto 13 $color 'Bold'
    $t.HorizontalAlignment = 'Center'
    $b.Child = $t
    $b.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        if ($s.Tag -eq 'auto') { Invoke-Auto } else { Invoke-BotonMotor $s.Tag }
    })
    [void]$barraFila.Children.Add($b)
    $script:BotonesBarra[$accion] = $b
}

New-BotonBarra 'PRO'   $C.Dim    'pro'
New-BotonBarra 'ERP'   '#3FB950' 'erp'
New-BotonBarra 'INTRA' '#3FB950' 'intra'
New-BotonBarra 'AUTO'  '#B07CF7'  'auto'
$Barra.Content = $barraBorde

$Barra.Add_Loaded({
    param($s, $e)
    $wa = [System.Windows.SystemParameters]::WorkArea
    $Barra.Left = $wa.Right  - $Barra.ActualWidth  - 16
    $Barra.Top  = $wa.Bottom - $Barra.ActualHeight - 16
})

if ($UsarBotonesMotor) {
    Update-Barra
    $Barra.Show()
    $Barra.Visibility = 'Hidden'
    if (-not $script:MotorOK) { Show-Flag 'Botones' $script:MotorError }

    # La barra solo se ve mientras el menu esta abierto (no tapa el ERP)
    $script:BarraTimer = New-Object System.Windows.Threading.DispatcherTimer
    $script:BarraTimer.Interval = [TimeSpan]::FromMilliseconds(150)
    $script:BarraTimer.Add_Tick({
        $verla = ($Win.Visibility -eq 'Visible') -and -not $script:MotorCorriendo
        $quiero = if ($verla) { 'Visible' } else { 'Hidden' }
        if ($Barra.Visibility -ne $quiero) {
            $Barra.Visibility = $quiero
            if ($verla) { Update-Barra }
        }
    })
    $script:BarraTimer.Start()
}

$Widget.Add_Closed({ [System.Windows.Threading.Dispatcher]::CurrentDispatcher.InvokeShutdown() })

try { Test-Setup } catch { Show-Flag 'Arranque' $_.Exception.Message }

[System.Windows.Threading.Dispatcher]::Run()
