# PRO lookup (PROLOOKUP del Excel)
# Copia el PRO de la bill abierta en el ERP (doble click, Shift+End, Ctrl+C)
# Espera a que llegue al portapapeles y reintenta 1 vez. Devuelve el PRO.
function Copiar-PRO {
    Traer-ERP | Out-Null
    $pro = ''
    for ($intento = 1; $intento -le 2 -and -not $pro; $intento++) {
        Paso "Copiando PRO (intento $intento de 2)"
        try { [System.Windows.Forms.Clipboard]::Clear() } catch {}
        # Click de "despertar": el 1er click al Escritorio Remoto a veces solo le da
        # el foco y no llega al ERP. Se da uno sencillo, se espera (para que no se
        # junte con el doble click) y luego el doble click que selecciona el PRO.
        ClickXY 'ERP_CampoPRO'
        Esperar 650
        DobleClickXY 'ERP_CampoPRO'
        Esperar 700
        Teclas '+{END}'
        Esperar 400
        Teclas '^c'
        $pro = Esperar-Portapapeles $Global:EsperaPROms
    }
    Teclas '{HOME}'
    Teclas '%c'
    Esperar
    if (-not $pro) { throw "No se copio el PRO despues de 2 intentos (portapapeles vacio). Revisa que la bill este abierta y el punto ERP_CampoPRO." }
    Paso "PRO copiado ($($pro.Length) caracteres)"
    if ($pro -notmatch '^\d{6,}$') { Paso 'AVISO: lo copiado no son solo numeros; puede que no sea el PRO' }
    return $pro
}

