function Paso([string]$m) {
    $Global:UltimoPaso = $m
    if ($Global:Debug -ne 1) { return }
    $l = '[{0}] {1}' -f (Get-Date -Format 'HH:mm:ss.fff'), $m
    Write-Host $l
    if ($Global:LogArchivo -eq 1) { try { Add-Content -Path $Global:ArchivoLog -Value $l } catch {} }
}

# Muestra en que paso fallo, el error y la linea del script
function Fallo($err, [string]$titulo = 'Motor') {
    $donde = $Global:UltimoPaso
    $linea = $err.InvocationInfo.ScriptLineNumber
    $archivo = Split-Path -Leaf $err.InvocationInfo.ScriptName
    $txt = "FALLO EN EL PASO:`n  $donde`n`nERROR:`n  $($err.Exception.Message)`n`nARCHIVO / LINEA:`n  $archivo  linea $linea`n`nNo se mando nada mas."
    $Global:Debug = 1
    Paso ("ERROR en [" + $donde + "] -> " + $err.Exception.Message + " ($archivo linea $linea)")
    [System.Windows.Forms.MessageBox]::Show($txt, $titulo) | Out-Null
}

